{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-chat",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 2,
    "enrichment_concurrency": 2
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 5.0,
        "topic_dedup": false
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "karpathy",
        "enabled": true,
        "category": "ai-ideas",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "vllm-project",
        "repo": "vllm",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "sgl-project",
        "repo": "sglang",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "langchain-ai",
        "repo": "langgraph",
        "enabled": true,
        "category": "ai-agent",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "openai-agents-python",
        "enabled": true,
        "category": "ai-agent",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "huggingface",
        "repo": "transformers",
        "enabled": true,
        "category": "ai-framework",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "ggml-org",
        "repo": "llama.cpp",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "zephyrproject-rtos",
        "repo": "zephyr",
        "enabled": true,
        "category": "embedded",
        "profile": "tech-news"
      },
      {
        "type": "repo_releases",
        "owner": "espressif",
        "repo": "esp-idf",
        "enabled": true,
        "category": "embedded",
        "profile": "tech-news"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 100,
      "category": "innovation",
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-news",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "SemiAnalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "ai-infrastructure",
        "profile": "tech-news"
      },
      {
        "name": "Hackaday",
        "url": "https://hackaday.com/feed/",
        "enabled": true,
        "category": "embedded-hardware",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "ai-research",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 50,
          "category": "llm-community",
          "profile": "tech-news"
        },
        {
          "subreddit": "robotics",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "category": "robotics",
          "profile": "tech-news"
        },
        {
          "subreddit": "embedded",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 30,
          "category": "embedded",
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "category": "ai-news",
          "profile": "tech-news"
        }
      ]
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "fetch_limit": 10,
      "profile": "tech-news"
    },
    "openbb": {
      "enabled": false,
      "watchlists": []
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": [
        "All",
        "Python",
        "TypeScript",
        "C++",
        "Rust"
      ],
      "keywords": [
        "AI",
        "agent",
        "LLM",
        "MCP",
        "robot",
        "embedded",
        "RISC-V"
      ],
      "min_stars": 20,
      "max_items": 30,
      "category": "github-trending",
      "profile": "tech-news"
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": true,
      "query": "AI agent OR LLM inference OR robotics OR embedded systems OR open source AI",
      "language": "zh-CN",
      "country": "CN",
      "max_results": 30,
      "category": "ai-news",
      "profile": "tech-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 25,
    "profile_order": [
      "tech-news",
      "tech-blog"
    ],
    "category_groups": {
      "ai": {
        "limit": 12,
        "categories": [
          "ai-news",
          "ai-agent",
          "ai-framework",
          "ai-ideas",
          "llm-inference",
          "ai-infrastructure",
          "ai-research",
          "llm-community"
        ]
      },
      "open-source": {
        "limit": 5,
        "categories": [
          "github-trending"
        ]
      },
      "robotics-embedded": {
        "limit": 6,
        "categories": [
          "robotics",
          "embedded",
          "embedded-hardware"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 7
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.qq.com",
    "smtp_port": 465,
    "smtp_username": "${HORIZON_EMAIL_ADDRESS}",
    "imap_server": "imap.qq.com",
    "imap_port": 993,
    "imap_enabled": false,
    "email_address": "${HORIZON_EMAIL_ADDRESS}",
    "password_env": "QQ_EMAIL_AUTH_CODE",
    "sender_name": "Horizon AI News Radar",
    "subscribe_keyword": "SUBSCRIBE",
    "unsubscribe_keyword": "UNSUBSCRIBE"
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "generic",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": [
      "zh"
    ],
    "request_body": {},
    "headers": ""
  }
}
